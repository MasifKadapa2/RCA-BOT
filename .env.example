# ---- Slack ----
# Bot User OAuth Token (xoxb-...) from the Slack app
SLACK_BOT_TOKEN=
# App-level token (xoxapp-...) used for Socket Mode
SLACK_APP_TOKEN=

# ---- Sentry ----
# Sentry auth token with read access to issues/events
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
# Optional: override for self-hosted Sentry (defaults to https://sentry.io/api/0)
SENTRY_BASE_URL=

# ---- Ollama ----
OLLAMA_BASE_URL=http://localhost:11434
# Lightweight coding-capable model recommended; must be pulled locally first
OLLAMA_MODEL=qwen2.5-coder:3b

# ---- Embeddings ----
# Local sentence-transformers model (kept small for laptop use)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Storage ----
DATABASE_URL=sqlite:///./data/rca_bot.db
CHROMA_PATH=./data/chroma

# ---- Repository ----
# The single local repository V1 investigates against
REPOSITORY_PATH=

# ---- Slack alert channel ----
# Channel ID where the existing Sentry -> Slack integration posts alerts.
# Only mentions in this channel trigger investigations.
SLACK_ALERT_CHANNEL_ID=

# ---- Optional configuration ----
LOG_LEVEL=INFO
MAX_RETRIEVAL_RESULTS=10
# Hard cap on characters of code context sent to the LLM
MAX_LLM_CONTEXT_CHARS=12000
# Confidence below this is flagged as low confidence in the Slack response
CONFIDENCE_THRESHOLD=60
